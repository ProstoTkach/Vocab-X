{
  "name": "vocabx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "pnpm --filter @vocabx/web test:db",
    "analytics:import": "pnpm --filter @vocabx/web analytics:import",
    "analytics:report": "pnpm --filter @vocabx/web analytics:report",
    "dev": "pnpm --filter @vocabx/web dev",
    "build": "pnpm --filter @vocabx/web build",
    "e2e": "pnpm --filter @vocabx/web e2e --project mobile --project desktop",
    "e2e:changed": "pnpm --filter @vocabx/web e2e:changed",
    "screenshots": "pnpm --filter @vocabx/web e2e --project screenshots",
    "metrics": "pnpm --filter @vocabx/web metrics"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@types/estree": "^1.0.10",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-vocabx": "workspace:*",
    "globals": "^17.14.0",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
