      },
      {
        "text": "At least the rent is cheap.",
        "credit": { "id": 13270436, "by": "menaud", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "I would like to rent it.",
        "credit": { "id": 13193588, "by": "Everybody", "license": "CC BY 2.0 FR" }
      }
    ],
    "en:landlord": [
      {
        "text": "Tom always complains about his landlord.",
        "credit": { "id": 12655120, "by": "rul", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Our landlord's name is Tom.",
        "credit": { "id": 12210187, "by": "Miktsoanit", "license": "CC0 1.0" }
      },
      {
        "text": "Kalman's inlaws are his landlords.",
        "credit": { "id": 12036150, "by": "Amastan", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Ziri got his landlord a gift.",
        "credit": { "id": 10225654, "by": "Amastan", "license": "CC BY 2.0 FR" }
      }
    ],
    "en:flat": [
      {
        "text": "Tom lives in a shared flat.",
        "credit": { "id": 13988540, "by": "araneo", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "She entered my flat without knocking.",
        "credit": { "id": 12593936, "by": "sundown", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "He sprinted down the flat road.",
        "credit": { "id": 12566416, "by": "Asif", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "She fell flat on the floor.",
        "credit": { "id": 13843589, "by": "Tom9358", "license": "CC BY 2.0 FR" }
      }
    ],
    "en:furniture": [
      {
        "text": "Ziri auctioned his old furniture online.",
