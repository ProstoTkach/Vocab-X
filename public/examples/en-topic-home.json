      },
      {
        "text": "Why did you rearrange the furniture?",
        "credit": { "id": 12579128, "by": "CK", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Your new furniture is very beautiful.",
        "credit": { "id": 12059781, "by": "carlosalberto", "license": "CC BY 2.0 FR" }
      }
    ],
    "en:kitchen": [
      {
        "text": "Put the glasses in the kitchen.",
        "credit": { "id": 13892131, "by": "LeeSooHa", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "He gets by in the kitchen.",
        "credit": { "id": 13886145, "by": "Nuel", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "I want to renovate my kitchen.",
        "credit": { "id": 13866717, "by": "Tom9358", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Take this away to the kitchen.",
        "credit": { "id": 13486827, "by": "frpzzd", "license": "CC BY 2.0 FR" }
      }
    ],
    "en:bedroom": [
      {
        "text": "My new house has four bedrooms.",
        "credit": { "id": 13232669, "by": "Lumi", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Sweet autumn air penetrates the bedroom.",
        "credit": { "id": 12728064, "by": "rul", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "That hallway leads to the bedrooms.",
        "credit": { "id": 13505488, "by": "rul", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Don't look in my bedroom.",
        "credit": { "id": 12995695, "by": "rul", "license": "CC BY 2.0 FR" }
      }
    ],
    "en:balcony": [
      {
        "text": "Ziri leaned on the balcony railing.",
