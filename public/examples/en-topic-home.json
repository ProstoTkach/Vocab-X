      }
    ],
    "en:tidy": [
      {
        "text": "We've tidied our room up.",
        "credit": { "id": 12463824, "by": "sundown", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "We've tidied up our room.",
        "credit": { "id": 12463823, "by": "sundown", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Sit down while I tidy up.",
        "credit": { "id": 12207523, "by": "CK", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "You should tidy up your room.",
        "credit": { "id": 13823537, "by": "Ergulis", "license": "CC BY 2.0 FR" }
      }
    ],
    "en:repair": [
      {
        "text": "Our neighbour repaired our oven yesterday.",
        "credit": { "id": 14032721, "by": "Ioan_Cristian", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Ziri repaired broken toys with glue.",
        "credit": { "id": 12649252, "by": "always", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "I repaired my brother's house.",
        "credit": { "id": 13639776, "by": "Babelball", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "I had someone repair my bicycle.",
        "credit": { "id": 13548063, "by": "LeviHighway", "license": "CC BY 2.0 FR" }
      }
    ],
    "en:move": [
      {
        "text": "Tom moved into a psychiatric hospital.",
        "credit": { "id": 14093516, "by": "Myrano_", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "He moved away after a year.",
        "credit": { "id": 13949842, "by": "frpzzd", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "He thought he saw something move.",
        "credit": { "id": 13905809, "by": "zogwarg", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Where is our society moving towards?",
        "credit": { "id": 13843212, "by": "rul", "license": "CC BY 2.0 FR" }
      }
    ],
    "en:key": [
      {
        "text": "I lost my keys last night.",
        "credit": { "id": 14053545, "by": "araneo", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "I gave my friend his keys.",
        "credit": { "id": 13982347, "by": "rul", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "I gave my friend her keys.",
        "credit": { "id": 13971639, "by": "rul", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Drop the key in the mailbox.",
        "credit": { "id": 13787987, "by": "Just_Balls", "license": "CC BY 2.0 FR" }
      }
    ],
    "en:laundry": [
      {
        "text": "Who does the laundry at home?",
        "credit": { "id": 13892148, "by": "rul", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "He picked up the laundry basket.",
        "credit": { "id": 13208376, "by": "Nuel", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Has the laundry been washed yet?",
        "credit": { "id": 13082579, "by": "Arkylie", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "He's doing laundry this afternoon.",
        "credit": { "id": 12952741, "by": "Conjuice", "license": "CC BY 2.0 FR" }
      }
    ],
    "en:carpet": [
      {
        "text": "Lukas noticed footprints on the carpet.",
        "credit": { "id": 11650367, "by": "Amastan", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Leon was hiding under a carpet.",
        "credit": { "id": 11645987, "by": "Amastan", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "They spilled coffee on the carpet.",
        "credit": { "id": 12634883, "by": "always", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "What's your favourite carpet colour?",
        "credit": { "id": 12008609, "by": "sundown", "license": "CC BY 2.0 FR" }
      }
    ],
    "en:shelf": [
      {
        "text": "The falling shelf broke his leg.",
        "credit": { "id": 12817767, "by": "rul", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Boris never uses the top shelf.",
        "credit": { "id": 11793771, "by": "Amastan", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Help! I accidentally built a shelf!",
        "credit": { "id": 10157953, "by": "espamatics", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "The books fell off the shelf.",
        "credit": { "id": 8888146, "by": "sundown", "license": "CC BY 2.0 FR" }
      }
    ],
    "en:deposit": [
      {
        "text": "Elias deposited fifty percent in advance.",
        "credit": { "id": 11611558, "by": "Amastan", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Does Western Sahara have oil deposits?",
        "credit": { "id": 10963077, "by": "Amastan", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Western Sahara has crude oil deposits.",
        "credit": { "id": 10896741, "by": "Amastan", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Western Sahara has rich phosphate deposits.",
        "credit": { "id": 10896725, "by": "Amastan", "license": "CC BY 2.0 FR" }
