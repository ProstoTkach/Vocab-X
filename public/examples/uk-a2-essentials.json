{
  "v": 1,
  "words": {
    "uk:подорож": [
      {
        "text": "Як пройшла твоя подорож до Австралії?",
        "credit": { "id": 6942365, "by": "oromashka", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Як пройшла твоя подорож до Італії?",
        "credit": { "id": 6905874, "by": "oromashka", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Розкажи мені все про свою подорож.",
        "credit": { "id": 6121302, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Це третя подорож Тома до Австралії.",
        "credit": { "id": 5927652, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:досвід": [
      {
        "text": "Щоб влаштуватися на роботу, потрібен досвід.",
        "credit": { "id": 11579823, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Цей досвід змінив Тома на краще.",
        "credit": { "id": 11392942, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Цей досвід змінив Тома на гірше.",
        "credit": { "id": 11392940, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Я знаю, що Том має досвід.",
        "credit": { "id": 9815965, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:рішення": [
      {
        "text": "Очікується, що вони скоро приймуть рішення.",
        "credit": { "id": 8897522, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Том сказав, що це твоє рішення.",
        "credit": { "id": 8473190, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Том проінформував мене про своє рішення.",
        "credit": { "id": 8401752, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Я хочу, щоб ви прийняли рішення.",
        "credit": { "id": 8050696, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:можливість": [
      {
        "text": "Дай мені хоча б можливість відповісти.",
        "credit": { "id": 6137189, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Дайте мені можливість вам це довести.",
        "credit": { "id": 4224951, "by": "shanghainese", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "По радіо попередили про можливість повені.",
        "credit": { "id": 494065, "by": "anastasishko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Вам потрібно серйозно розглянути можливість зробити це.",
        "credit": { "id": 6281698, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:порада": [
      {
        "text": "Моя порада — Тому нічого не даруй.",
        "credit": { "id": 8343422, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Моя порада — Тому нічого не даруйте.",
        "credit": { "id": 8343421, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Моя порада — нічого не даруй Тому.",
        "credit": { "id": 8343420, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Моя порада — нічого не даруйте Тому.",
        "credit": { "id": 8343419, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:знання": [
      {
        "text": "Філософи розрізняють апріорне на апостеріорне знання.",
        "credit": { "id": 5153394, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Знання можна отримати лише через навчання.",
        "credit": { "id": 493362, "by": "aandrusiak", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Він передав усі свої знання синові.",
        "credit": { "id": 480685, "by": "uaspeaker", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Наші знання про цю проблему доволі обмежені.",
        "credit": { "id": 11063138, "by": "Ahha", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:погода": [
      {
        "text": "Скільки ще триватиме ця холодна погода?",
        "credit": { "id": 6874383, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Мені цікаво, чи погода не зміниться.",
        "credit": { "id": 6693118, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Сподіваюся, що завтра буде добра погода.",
        "credit": { "id": 5771006, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Сьогодні погода ще краща за учора.",
        "credit": { "id": 4419413, "by": "shanghainese", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:довкілля": [
      {
        "text": "Питання захисту довкілля сьогодні було порушено мною не випадково.",
        "credit": { "id": 9512470, "by": "Ahha", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Том хотів би берегти довкілля, але він не знає як.",
        "credit": { "id": 9484980, "by": "Ahha", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "\"Лу, у кожному місті є велике сміттєзвалище, яке насичує отрутою довкілля\". - \"Стіве, люди повинні знати.\"",
        "credit": { "id": 10125205, "by": "Ahha", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:поведінка": [
      {
        "text": "Така поведінка поже призвести до нащасного випадку.",
        "credit": { "id": 5718592, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Непередбачувана поведінка Тома завжди тримала Мері у напрузі, вона ніколи не знала, що він зробить далі.",
        "credit": { "id": 11844952, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Його поведінка була дивною та неспокійною.",
        "credit": { "id": 10135279, "by": "Walentinio", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:зустріч": [
      {
        "text": "Навряд він забув про нашу зустріч.",
        "credit": { "id": 11704350, "by": "bicolino34", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Моя зустріч відбудеться о 2:30.",
        "credit": { "id": 6908547, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Ніхто не розповів мені про зустріч.",
        "credit": { "id": 6578289, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Ніхто не сказав мені про зустріч.",
        "credit": { "id": 6578287, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:досягати": [
      {
        "text": "У Бразилії поширеність синдрому Аспергера може досягати 0,5%.",
        "credit": { "id": 5748109, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:уникати": [
      {
        "text": "Том усе ще намається уникати Мері.",
        "credit": { "id": 6326517, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Том намагається уникати суперечок із Мері.",
        "credit": { "id": 1653424, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Ти мусиш уникати робити такі помилки.",
        "credit": { "id": 1579188, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Том має добрий привід, щоб уникати Мері.",
        "credit": { "id": 7499105, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:скаржитися": [
      {
        "text": "Будь ласка, не треба так часто скаржитися.",
        "credit": { "id": 8071650, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Будь ласка, не треба так багато скаржитися.",
        "credit": { "id": 8071649, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Я намагаюся ніколи не скаржитися на їжу.",
        "credit": { "id": 5868778, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "В тебе немає жодної причини скаржитися ані на що.",
        "credit": { "id": 4653192, "by": "shanghainese", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:вимагати": [
      {
        "text": "Ми тут для того, щоб вимагати правосуддя.",
        "credit": { "id": 7717596, "by": "Oleksandr_Tahayev", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Ми тут для того, щоб вимагати справедливості.",
        "credit": { "id": 7717590, "by": "Oleksandr_Tahayev", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Новий контракт дозволяє нам вимагати все, що нам потрібно.",
        "credit": { "id": 500419, "by": "brambury", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Ти можеш не можеш приходити до мене абиколи та ще й вимагати в мене гроші.",
        "credit": { "id": 9485156, "by": "Ahha", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:впоратися": [
      {
        "text": "Ми маємо впоратися з цією проблемою.",
        "credit": { "id": 7807970, "by": "Oleksandr_Tahayev", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Ніхто не може впоратися з ним.",
        "credit": { "id": 505710, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Я не зміг впоратися зі своїм гнівом.",
        "credit": { "id": 6771406, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Чи можете ви з цим впоратися?",
        "credit": { "id": 7354078, "by": "Anjy", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:вирішувати": [
      {
        "text": "Том знає, що вирішувати має він.",
        "credit": { "id": 7999040, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Тобі вирішувати - йти, чи не йти.",
        "credit": { "id": 918564, "by": "ascolto", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Вам вирішувати, поїдемо ми туди чи ні.",
        "credit": { "id": 6927638, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Тобі вирішувати, поїдемо ми туди чи ні.",
        "credit": { "id": 6927637, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:надійний": [
      {
        "text": "Ви дійсно думаєте, що Том надійний?",
        "credit": { "id": 8384686, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Ти дійсно думаєш, що Том надійний?",
        "credit": { "id": 8384684, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Будь ласка, оберіть більш надійний пароль.",
        "credit": { "id": 6465722, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Мені цікаво, чи Том надійний, чи ні.",
        "credit": { "id": 6693021, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:впевнений": [
      {
        "text": "Том не впевнений, чи Мері брехала.",
        "credit": { "id": 13336440, "by": "artemlyubchenko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Ти впевнений що вона не бреше?",
        "credit": { "id": 9803738, "by": "ElSwanko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Я впевнений, що ми це зробимо.",
        "credit": { "id": 8900240, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Я не впевнений, що я згоден.",
        "credit": { "id": 8742376, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:доступний": [
      {
        "text": "Наскільки мені відомо, це єдиний доступний переклад.",
        "credit": { "id": 7810864, "by": "Oleksandr_Tahayev", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Цей сервер доступний тільки через наш VPN.",
        "credit": { "id": 7789507, "by": "User55521", "license": "CC0 1.0" }
      }
    ],
    "uk:стурбований": [
      {
        "text": "Том сказав, що в мене стурбований вигляд.",
        "credit": { "id": 10282978, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Я дуже стурбований станом твого здоров'я.",
        "credit": { "id": 495766, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Том не такий стурбований, як я.",
        "credit": { "id": 8905045, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Я не такий стурбований, як Том.",
        "credit": { "id": 8721045, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:особливо": [
      {
        "text": "Я люблю слухати музику, особливо джаз.",
        "credit": { "id": 6770810, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Я люблю всі ягоди, особливо полуницю.",
        "credit": { "id": 5720783, "by": "lingvokrolik", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Пантеїзм нешкідливий, але й не особливо цікавий.",
        "credit": { "id": 8105997, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Мені подобається все французьке, особливо їхній сир.",
        "credit": { "id": 5800471, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:зручний": [
      {
        "text": "Я поговорю з вами у більш зручний час.",
        "credit": { "id": 5900459, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Я поговорю з тобою у більш зручний час.",
        "credit": { "id": 5900458, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Деякі вважають, що зараз дуже зручний момент для приєднання Криму та інших регіонів України до Росії.",
        "credit": { "id": 3946750, "by": "shanghainese", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:вплив": [
      {
        "text": "Я знаю, що Том має вплив.",
        "credit": { "id": 6688721, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Багато телепередач мають поганий вплив на дітей.",
        "credit": { "id": 7987786, "by": "deniko", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Він має великий вплив в світі медицини.",
        "credit": { "id": 922198, "by": "ascolto", "license": "CC BY 2.0 FR" }
      },
      {
        "text": "Вони мають самий безпосередній вплив на життя людей.",
        "credit": { "id": 5727086, "by": "deniko", "license": "CC BY 2.0 FR" }
      }
    ],
    "uk:спроба": [
      {
        "text": "Його спроба переплисти річку не вдалася.",
        "credit": { "id": 946681, "by": "ascolto", "license": "CC BY 2.0 FR" }
      }
    ]
  }
}
