      "examples": [
        {
          "text": "We worked overtime to finish on time.",
          "translations": {
            "uk": "Ми працювали понаднормово, щоб устигнути."
          }
        }
      ]
    },
    {
      "term": "report",
      "pos": "noun",
      "translations": {
        "uk": ["звіт"]
      },
      "examples": [
        {
          "text": "Please send me the report.",
          "translations": {
            "uk": "Надішли мені, будь ласка, звіт."
          }
        }
      ]
    },
    {
      "term": "shift",
      "pos": "noun",
      "translations": {
        "uk": ["зміна"]
      },
      "examples": [
        {
          "text": "The night shift starts at ten.",
          "translations": {
            "uk": "Нічна зміна починається о десятій."
          }
        }
      ]
    },
    {
      "term": "department",
      "pos": "noun",
      "translations": {
        "uk": ["відділ"]
      },
      "examples": [
        {
          "text": "She works in the sales department.",
          "translations": {
            "uk": "Вона працює у відділі продажів."
          }
        }
      ]
    },
    {
      "term": "resign",
      "pos": "verb",
      "translations": {
        "uk": ["звільнятися"]
      },
      "examples": [
        {
          "text": "He decided to resign after five years.",
          "translations": {
            "uk": "Він вирішив звільнитися через п'ять років."
          }
        }
      ]
    },
    {
      "term": "workload",
      "pos": "noun",
      "translations": {
        "uk": ["навантаження"]
      },
      "examples": [
        {
          "text": "My workload is too heavy.",
          "translations": {
            "uk": "У мене надто велике навантаження."
          }
        }
      ]
    }
