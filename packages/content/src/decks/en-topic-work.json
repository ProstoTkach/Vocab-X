      },
      "examples": [
        {
          "text": "The deadline is on Friday.",
          "translations": {
            "uk": "Дедлайн — у п'ятницю."
          }
        }
      ]
    },
    {
      "term": "meeting",
      "pos": "noun",
      "translations": {
        "uk": ["нарада", "зустріч"]
      },
      "examples": [
        {
          "text": "We have a meeting at ten.",
          "translations": {
            "uk": "У нас нарада о десятій."
          }
        }
      ]
    },
    {
      "term": "salary",
      "pos": "noun",
      "translations": {
        "uk": ["зарплата"]
      },
      "examples": [
        {
          "text": "She asked for a higher salary.",
          "translations": {
            "uk": "Вона попросила вищу зарплату."
          }
        }
