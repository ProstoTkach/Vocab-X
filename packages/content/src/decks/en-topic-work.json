  "descriptionI18n": {
    "uk": "Колеги, наради, дедлайни й зарплата — повсякденна мова роботи.",
    "en": "Colleagues, meetings, deadlines and pay — the everyday language of work."
  },
  "words": [
    {
      "term": "colleague",
      "pos": "noun",
      "translations": {
        "uk": ["колега"]
      },
      "examples": [
        {
          "text": "My colleague helped me with the slides.",
          "translations": {
            "uk": "Колега допоміг мені зі слайдами."
          }
        }
      ]
    },
    {
      "term": "deadline",
      "pos": "noun",
      "translations": {
