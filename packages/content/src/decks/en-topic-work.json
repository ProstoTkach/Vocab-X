          }
        }
      ]
    },
    {
      "term": "task",
      "pos": "noun",
      "translations": {
        "uk": ["завдання"]
      },
      "examples": [
        {
          "text": "This task will take an hour.",
          "translations": {
            "uk": "Це завдання займе годину."
          }
        }
