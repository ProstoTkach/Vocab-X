          }
        }
      ]
    },
    {
      "term": "spend",
      "pos": "verb",
      "translations": {
        "uk": ["витрачати"]
      },
      "examples": [
        {
          "text": "Don't spend everything at once.",
          "translations": {
            "uk": "Не витрачай усе одразу."
          }
        }
      ]
    },
    {
      "term": "bargain",
      "pos": "noun",
      "translations": {
        "uk": ["вигідна покупка"]
      },
      "examples": [
        {
          "text": "This jacket was a real bargain.",
          "translations": {
            "uk": "Ця куртка була справді вигідною покупкою."
          }
        }
      ]
    },
    {
      "term": "price",
      "pos": "noun",
      "translations": {
        "uk": ["ціна"]
      },
      "examples": [
        {
          "text": "The price has gone up.",
          "translations": {
            "uk": "Ціна зросла."
          }
        }
      ]
    },
    {
      "term": "invoice",
      "pos": "noun",
      "translations": {
        "uk": ["рахунок-фактура"]
      },
      "examples": [
        {
          "text": "Send the invoice by email.",
          "translations": {
            "uk": "Надішліть рахунок-фактуру електронною поштою."
          }
        }
      ]
    },
    {
      "term": "tax",
      "pos": "noun",
      "translations": {
        "uk": ["податок"]
      },
      "examples": [
        {
          "text": "The tax is included.",
          "translations": {
            "uk": "Податок включено."
          }
        }
      ]
    },
    {
      "term": "income",
      "pos": "noun",
      "translations": {
        "uk": ["дохід"]
      },
      "examples": [
        {
          "text": "Her income has doubled.",
          "translations": {
            "uk": "Її дохід подвоївся."
          }
        }
      ]
    },
    {
      "term": "withdraw",
      "pos": "verb",
      "translations": {
        "uk": ["знімати (гроші)"]
      },
      "examples": [
        {
          "text": "I need to withdraw some money.",
          "translations": {
            "uk": "Мені треба зняти трохи грошей."
          }
        }
      ]
    },
    {
      "term": "subscription",
      "pos": "noun",
      "translations": {
        "uk": ["підписка"]
      },
      "examples": [
        {
          "text": "Cancel the subscription before May.",
          "translations": {
            "uk": "Скасуй підписку до травня."
          }
        }
      ]
    },
    {
      "term": "wallet",
      "pos": "noun",
      "translations": {
        "uk": ["гаманець"]
      },
      "examples": [
        {
          "text": "I lost my wallet on the bus.",
          "translations": {
            "uk": "Я загубив гаманець в автобусі."
          }
        }
      ]
    }
  ]
}
