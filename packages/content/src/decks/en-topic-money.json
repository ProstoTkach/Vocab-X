{
  "id": "builtin:en-topic-money",
  "lang": "en",
  "cefr": "B1",
  "topic": "money",
  "title": "Money and shopping",
  "titleI18n": {
    "uk": "Гроші та покупки",
    "en": "Money and shopping"
  },
  "descriptionI18n": {
    "uk": "Знижки, борги, бюджет і підписки — щоб розумітися на грошах.",
    "en": "Discounts, debts, budgets and subscriptions — to handle money with ease."
  },
  "words": [
    {
      "term": "discount",
      "pos": "noun",
      "translations": {
        "uk": ["знижка"]
      },
      "examples": [
        {
          "text": "There is a 20% discount today.",
          "translations": {
            "uk": "Сьогодні знижка 20%."
          }
        }
      ]
    },
    {
      "term": "refund",
      "pos": "noun",
      "translations": {
        "uk": ["повернення грошей"]
      },
      "examples": [
        {
          "text": "Can I get a refund?",
          "translations": {
            "uk": "Можна повернути гроші?"
          }
        }
      ]
    },
    {
      "term": "cash",
      "pos": "noun",
      "translations": {
        "uk": ["готівка"]
      },
      "examples": [
        {
          "text": "Do you pay by card or in cash?",
          "translations": {
            "uk": "Ви платите карткою чи готівкою?"
          }
        }
      ]
    },
    {
      "term": "loan",
      "pos": "noun",
      "translations": {
        "uk": ["позика", "кредит"]
      },
      "examples": [
        {
          "text": "They took a loan to buy a car.",
          "translations": {
            "uk": "Вони взяли кредит, щоб купити авто."
          }
        }
      ]
    },
    {
      "term": "debt",
      "pos": "noun",
      "translations": {
        "uk": ["борг"]
      },
      "examples": [
        {
          "text": "He paid off his debt.",
          "translations": {
            "uk": "Він виплатив свій борг."
          }
        }
      ]
    },
    {
      "term": "budget",
      "pos": "noun",
      "translations": {
        "uk": ["бюджет"]
      },
      "examples": [
        {
          "text": "We need to plan our budget.",
          "translations": {
            "uk": "Нам треба спланувати бюджет."
          }
        }
      ]
    },
    {
      "term": "save",
      "pos": "verb",
      "translations": {
        "uk": ["заощаджувати"]
      },
      "examples": [
        {
          "text": "I save some money every month.",
          "translations": {
