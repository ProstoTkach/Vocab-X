{
  "name": "@vocabx/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-media.mjs && next dev",
    "build": "node scripts/sync-media.mjs && next build",
    "sync-media": "node scripts/sync-media.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "playwright test",
    "e2e:changed": "node scripts/e2e-changed.mjs",
    "metrics": "node scripts/bundle-report.mjs && playwright test --project metrics",
    "e2e:browsers": "node scripts/e2e-browsers.mjs",
    "e2e:smoke": "playwright test --grep @smoke --project desktop",
    "db:check": "node scripts/db-check.mjs",
    "db:generate": "drizzle-kit generate",
    "db:generate:anon": "drizzle-kit generate --config drizzle-anon.config.ts",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed-test": "node scripts/db-seed-test-users.mjs",
    "test:db": "node scripts/test-db.mjs",
    "analytics:import": "jiti scripts/analytics-import.ts",
    "analytics:report": "jiti scripts/analytics-report.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@sentry/nextjs": "^11.15.0",
    "@vocabx/content": "workspace:*",
    "@vocabx/core": "workspace:*",
    "@vocabx/data": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.76.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "next-auth": "^4.24.15",
    "next-intl": "^4.15.3",
    "nodemailer": "^10.6.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@formatjs/icu-messageformat-parser": "^3.5.23",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5"
  }
}
