# Copy to apps/web/.env and fill in. Locally everything is optional: without a variable the
# matching feature is simply off (no database, no letters, no push). On Vercel set them in the
# project settings. Never commit real values.

# --- Site ---
# The site's own address, no trailing slash. Links in letters, sign-in, the sitemap and the push
# sender all come from it. Locally: http://localhost:3000
NEXTAUTH_URL=
# Signs the session cookie and the registration proof. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Database (Neon) ---
# Pooled address: the app.
DATABASE_URL=
# Direct address: migrations (pnpm db:migrate). Mind that .env may point at the main database.
DATABASE_URL_DIRECT=
# A Neon branch for pnpm test:db. Must differ from DATABASE_URL, the script refuses otherwise.
DATABASE_URL_TEST=

# --- Google sign-in (OAuth client) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google service account (Sheets for feedback/analytics, Cloud Translation) ---
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_EMAIL=
# Keep the \n escapes inside the quotes.
GOOGLE_PRIVATE_KEY=
# Spreadsheet ids (the part of the address between /d/ and /edit); share both with GOOGLE_CLIENT_EMAIL.
GOOGLE_SPREADSHEET_POLLS_ID=
GOOGLE_SPREADSHEET_ANALYTICS_ID=

# --- Feedback fallback (Telegram), used when the spreadsheet is down ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Letters (SMTP). Without user and password, locally, the link is printed to the console ---
EMAIL_SERVER_USER=
# Gmail: an app password (16 characters), not the account password.
EMAIL_SERVER_PASSWORD=
# Optional: another SMTP server (default smtp.gmail.com, port 465) and the From line.
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=
EMAIL_FROM=
# Optional: letters a day for everyone together (default 300, under Gmail's 500).
EMAIL_DAILY_LIMIT=

# --- Web Push (daily reminders): a P-256 key pair in base64url, see lib/push.ts ---
# The public key goes to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional: mailto:you@example.com. Without it the sender is NEXTAUTH_URL.
VAPID_SUBJECT=

# --- Other ---
# Vercel Cron sends it as a Bearer token to /api/push/cron and /api/cleanup. Any long random string.
CRON_SECRET=
# Opens the developer mode in the settings. Any code you will remember.
DEVELOPER_CODE=
# Optional: Google Translate characters a day for everyone together (default 15000; 0 turns it off).
TRANSLATE_DAILY_CHARS=

# --- Kill switches (1, true or on = off; empty = working). Set in the Vercel settings, redeploy. ---
# Google Translate suggestions (dictionaries keep working).
KILL_TRANSLATE=
# Signing up with an email and a password (signing in stays).
KILL_REGISTRATION=
# The weekly league: joining and reading (leaving stays).
KILL_LEAGUE=
# Writing usage events to the analytics spreadsheet (the app sees nothing).
KILL_ANALYTICS=
